{
  "manifest_version": 3,
  "name": "iNat Batch Annotate",
  "short_name": "Batch Annotate",
  "version": "1.0.0",
  "description": "Add the same annotation (Life Stage, Sex, Alive or Dead, Evidence of Presence, ...) to many iNaturalist observations at once.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_title": "Batch annotate observations",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "32": "icons/toolbar-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.inaturalist.org/*", "https://inaturalist.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://www.inaturalist.org/*",
    "https://inaturalist.org/*",
    "https://api.inaturalist.org/*"
  ]
}
